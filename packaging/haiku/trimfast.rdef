/*
 * Resources of the TrimFast application (compiled with `rc`, attached with `xres`).
 */

resource app_signature "application/x-vnd.TrimFast";

resource app_flags B_SINGLE_LAUNCH;

/* Offered in Tracker's "Open With" for every video file. The file arrives as a
   QFileOpenEvent (see src/app/TrimFastApplication.h). */
resource file_types message {
	"types" = "video"
};

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 2,

	variety = B_APPV_DEVELOPMENT,
	internal = 0,

	short_info = "Lossless video trimmer",
	long_info = "TrimFast - cut video without re-encoding (FFmpeg stream copy)"
};
